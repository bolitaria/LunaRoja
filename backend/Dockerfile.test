FROM node:22-slim
WORKDIR /app

# Instalar dependencias de desarrollo (jest, supertest, etc.)
COPY package.json package-lock.json ./
RUN npm ci

# Copiar el código fuente y los tests
COPY src ./src
COPY tests ./tests

# Ejecutar unitarias + integración
CMD ["sh", "-c", "npm exec jest tests/unit tests/integration -- --forceExit --detectOpenHandles"]
