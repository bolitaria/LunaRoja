# ============================================================
# LunaRoja — Variables de entorno (plantilla DEV)
# Copia a .env y rellena los valores.
# ============================================================

# ─── PostgreSQL ───
POSTGRES_USER=lunaroja
POSTGRES_PASSWORD=CAMBIA_ESTO_openssl_rand_base64_32
POSTGRES_DB=lunaroja

# ─── Backend ───
# Generar con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_openssl_rand_hex_64
JWT_REFRESH_SECRET=CAMBIA_ESTO_openssl_rand_hex_64
ADMIN_PASSWORD=CAMBIA_ESTO_password_admin

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOGO_URL=http://localhost:3000/logo.svg

# ─── Pool de conexiones (opcional) ───
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_POOL_ACQUIRE=30000
PG_POOL_IDLE=10000
PG_POOL_EVICT=1000
QUEUE_CONCURRENCY=10

# ─── Rate limiting ───
RATE_LIMIT_MAX_PUBLIC=2000
RATE_LIMIT_MAX_ADMIN=200

# ─── Frontend (build args) ───
NEXT_PUBLIC_CONTACT_EMAIL=vocesdepalestina@tutamail.com
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/stories/voces_palestinas_malaga

# ─── Grafana (--profile monitoring) ───
GRAFANA_ADMIN_PASSWORD=CAMBIA_ESTO_password_grafana

# ─── SMTP para alertas Grafana (--profile monitoring) ───
SMTP_PASSWORD=CAMBIA_ESTO_password_smtp

# ─── pgAdmin (--profile tools) ───
PGADMIN_DEFAULT_EMAIL=admin@lunaroja.org
PGADMIN_DEFAULT_PASSWORD=CAMBIA_ESTO_password_pgadmin

# ─── Logging ───
LOG_LEVEL=info
